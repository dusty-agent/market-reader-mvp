# Optional local ffmpeg path.
# Leave blank when ffmpeg is in PATH.
FFMPEG_PATH=

# Optional: use an already-installed Chrome / Edge executable
# instead of Playwright Chromium.
# Example: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=