# KRX Data Marketplace Open API
# KRX_OPENAPI_KEY=

# 한국수출입은행 현재환율 API
KOREAEXIM_EXCHANGE_API_KEY=

# 한국수출입은행 대출금리 API
KOREAEXIM_INTEREST_API_KEY=

# Metals.Dev (gold / silver / copper)
